<Window x:Class="ExpoReturn.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExpoReturn.Desktop.ViewModels"
        xmlns:v="clr-namespace:ExpoReturn.Desktop.Views"
        Title="{Binding AppTitle}" Height="860" Width="1480" MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewReturnCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PalletListViewModel}"><v:PalletListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PalletDetailViewModel}"><v:PalletDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}"><v:AlertsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side navigation ===== -->
        <DockPanel Background="{StaticResource Primary}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,24">
                <TextBlock Text="JuP1 · ME/QMM" Foreground="#93C5FD" FontSize="11.5" />
                <TextBlock Text="Expo &amp; Return" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="FG Follow Up" Foreground="White" FontSize="15" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18">
                <Button Content="Import Excel 2.0…" Command="{Binding ImportExcelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                        ToolTip="Loads the MATRIZ DE RASTREO 2.0 in memory (read-only) to see real data" />
                <Button Content="Reset demo data" Command="{Binding ResetDemoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <Button Content="Import MM60 file…" Command="{Binding ImportMm60Command}" Style="{StaticResource SecondaryButton}" Margin="0"
                            ToolTip="Owner: loads the MM60 report exported from SAP (Material, Price, Price unit). Unit costs of new returns come from it" />
                    <TextBlock Text="{Binding Mm60Text}" Foreground="#93C5FD" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="✎  Send feedback" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource PrimaryButton}" Background="#2E75B6" BorderBrush="#2E75B6" Margin="0" />
                <TextBlock Text="v0.2.2 · draft" Foreground="#93C5FD" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Content ===== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DraftNotice}" Foreground="#B45309" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding DataSourceLabel}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                        <TextBlock Foreground="#7C3AED" FontWeight="SemiBold" FontSize="12"
                                   Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}">
                            <Run Text="PREVIEW · you are seeing the app with the access of " /><Run Text="{Binding CurrentUser.DisplayName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Windows user running the app and the access the Owner assigned -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding IdentityText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding AccessText}" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Content="My profile" Command="{Binding EditProfileCommand}" Style="{StaticResource SecondaryButton}"
                                ToolTip="Change your name, department or Value Streams (department / VS changes need Owner approval)" />
                        <!-- Owner only: preview as another user -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PendingRequestsText}" Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="View as:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <ComboBox ItemsSource="{Binding ViewAsOptions}" SelectedItem="{Binding CurrentUser}" Width="360" MaxDropDownHeight="560"
                                      IsSynchronizedWithCurrentItem="False"
                                      ToolTip="Owner only: see the application with another user's access to check their functions">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
<Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="#6B7280" /><Run Text="{Binding AreaText, Mode=OneWay}" /><Run Text=" · " Foreground="#6B7280" /><Run Text="{Binding ValueStreamText, Mode=OneWay}" /><Run Text=" · " Foreground="#6B7280" /><Run Text="{Binding FunctionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#E5E7EB" Padding="8,3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F3864" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="20,16,20,16" />
        </DockPanel>
    </Grid>
</Window>
