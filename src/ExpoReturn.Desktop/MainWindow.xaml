<Window x:Class="ExpoReturn.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExpoReturn.Desktop.ViewModels"
        xmlns:v="clr-namespace:ExpoReturn.Desktop.Views"
        Title="{Binding AppTitle}" Height="860" Width="1480" MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewReturnCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PalletListViewModel}"><v:PalletListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PalletDetailViewModel}"><v:PalletDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}"><v:AlertsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RequestsViewModel}"><v:RequestsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Side menu: 230 px, or 56 px (icons only) when collapsed (☰ / Ctrl+B; remembered per user) -->
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="230" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True"><Setter Property="Width" Value="56" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Side navigation ===== -->
        <DockPanel Background="{StaticResource Primary}">
            <DockPanel DockPanel.Dock="Top" Margin="8,12,8,18">
                <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Command="{Binding ToggleNavCommand}" Width="40" Height="34" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="16">
                    <!-- "<" collapses, ">" expands (a ☰ looked like the first menu entry) -->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="&#xE76B;" />
                            <Setter Property="ToolTip" Value="Collapse the menu (Ctrl+B)" />
                            <Setter Property="AutomationProperties.Name" Value="Collapse the menu" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                    <Setter Property="Content" Value="&#xE76C;" />
                                    <Setter Property="ToolTip" Value="Expand the menu (Ctrl+B)" />
                                    <Setter Property="AutomationProperties.Name" Value="Expand the menu" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2B4A80" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Margin="10,6,10,0" Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBlock Text="JuP1 · ME/QMM" Foreground="#93C5FD" FontSize="11.5" />
                    <TextBlock Text="Expo &amp; Return" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="FG Follow Up" Foreground="White" FontSize="15" />
                </StackPanel>
            </DockPanel>
            <!-- Collapsed: only Reload and Send feedback, as icons (imports are Owner tasks: expand the menu) -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,12,8,18" Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVis}}">
                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="0" Height="34" Margin="0,0,0,8" ToolTip="Reload" AutomationProperties.Name="Reload" />
                <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource PrimaryButton}"
                        Background="#2E75B6" BorderBrush="#2E75B6" Padding="0" Height="34" Margin="0" ToolTip="Send feedback" AutomationProperties.Name="Send feedback" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18" Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <Button Content="⟳  Reload" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                        ToolTip="Reads again the records, users and alerts saved by other people" />
                <Button Content="Import Excel 2.0…" Command="{Binding ImportExcelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                        Visibility="{Binding CanImportExcel, Converter={StaticResource BoolToVis}}"
                        ToolTip="Owner: saves the rows of the MATRIZ DE RASTREO 2.0 as editable records (each row once; later imports never overwrite edits) and its MM60 COST SAP sheet as the cost master" />
                <StackPanel Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <Button Content="Import MM60 file…" Command="{Binding ImportMm60Command}" Style="{StaticResource SecondaryButton}" Margin="0"
                            ToolTip="Owner: loads the MM60 report exported from SAP (Material, Price, Price unit). Unit costs of new returns come from it" />
                    <TextBlock Text="{Binding Mm60Text}" Foreground="#93C5FD" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="✎  Send feedback" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource PrimaryButton}" Background="#2E75B6" BorderBrush="#2E75B6" Margin="0" />
                <TextBlock Text="{Binding VersionText}" Foreground="#93C5FD" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                     PreviewMouseLeftButtonUp="OnNavClick"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Content ===== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataSourceLabel}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Foreground="#7C3AED" FontWeight="SemiBold" FontSize="12"
                                   Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}">
                            <Run Text="PREVIEW · you are seeing the app with the access of " /><Run Text="{Binding CurrentUser.DisplayName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Windows user running the app and the access the Owner assigned -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding IdentityText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding AccessText}" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Content="My profile" Command="{Binding EditProfileCommand}" Style="{StaticResource SecondaryButton}"
                                ToolTip="Change your name, department or Value Streams (department / VS changes need Owner approval)" />
                        <!-- Owner only: preview as another user -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PendingRequestsText}" Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="View as:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMuted}" />
                            <ComboBox ItemsSource="{Binding ViewAsOptions}" SelectedItem="{Binding CurrentUser}" Width="360" MaxDropDownHeight="560"
                                      IsSynchronizedWithCurrentItem="False"
                                      ToolTip="Owner only: see the application with another user's access to check their functions">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
<Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " Foreground="#6B7280" /><Run Text="{Binding AreaText, Mode=OneWay}" /><Run Text=" · " Foreground="#6B7280" /><Run Text="{Binding ValueStreamText, Mode=OneWay}" /><Run Text=" · " Foreground="#6B7280" /><Run Text="{Binding FunctionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#E5E7EB" Padding="8,3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1F3864" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="20,16,20,16" />
        </DockPanel>
    </Grid>
</Window>
