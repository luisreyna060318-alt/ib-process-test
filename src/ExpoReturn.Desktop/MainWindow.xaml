<Window x:Class="ExpoReturn.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExpoReturn.Desktop.ViewModels"
        xmlns:v="clr-namespace:ExpoReturn.Desktop.Views"
        Title="{Binding AppTitle}" Height="860" Width="1480" MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PalletListViewModel}"><v:PalletListView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PalletDetailViewModel}"><v:PalletDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}"><v:AlertsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChampionsViewModel}"><v:ChampionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navegación lateral ===== -->
        <DockPanel Background="{StaticResource Primary}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,24">
                <TextBlock Text="JuP1 · ME/QMM" Foreground="#93C5FD" FontSize="11.5" />
                <TextBlock Text="Expo &amp; Return" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="FG Follow Up" Foreground="White" FontSize="15" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18">
                <Button Content="Importar Excel 2.0…" Command="{Binding ImportExcelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                        ToolTip="Carga la MATRIZ DE RASTREO 2.0 en memoria (sólo lectura) para ver datos reales" />
                <Button Content="Restaurar datos demo" Command="{Binding ResetDemoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                <Button Content="✎  Enviar comentario" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource PrimaryButton}" Background="#2E75B6" BorderBrush="#2E75B6" Margin="0" />
                <TextBlock Text="v0.1.1 · borrador" Foreground="#93C5FD" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="28" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Contenido ===== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DraftNotice}" Foreground="#B45309" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding DataSourceLabel}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Usuario simulado (rol / VS):" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}" />
                        <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding CurrentUser}" DisplayMemberPath="Label" Width="460"
                                  ToolTip="En producción el usuario sale de Windows (Active Directory) y la matriz Champions_VS" />
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="20,16,20,16" />
        </DockPanel>
    </Grid>
</Window>
