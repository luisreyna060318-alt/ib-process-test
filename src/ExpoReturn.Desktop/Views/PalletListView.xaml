<UserControl x:Class="ExpoReturn.Desktop.Views.PalletListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
    </UserControl.InputBindings>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Returns inbox" Style="{StaticResource PageTitle}" />
            <TextBlock FontSize="14.5" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,12">
                <Run Text="Double-click" FontWeight="SemiBold" /><Run Text=" or " /><Run Text="Enter" FontWeight="SemiBold" /><Run Text=" opens a record   ·   " />
                <Run Text="Ctrl+F" FontWeight="SemiBold" /><Run Text=" search   ·   " /><Run Text="Ctrl+E" FontWeight="SemiBold" /><Run Text=" export   ·   " /><Run Text="Ctrl+N" FontWeight="SemiBold" /><Run Text=" new return" />
            </TextBlock>

            <!-- Indicators: always follow the filters, also while the table is not shown -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource KpiCard}">
                        <Setter Property="Padding" Value="20,14" />
                        <Setter Property="MinWidth" Value="190" />
                    </Style>
                    <Style x:Key="BigLabel" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}"><Setter Property="FontSize" Value="13.5" /></Style>
                    <Style x:Key="BigValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}"><Setter Property="FontSize" Value="30" /></Style>
                </StackPanel.Resources>
                <Border>
                    <StackPanel><TextBlock Text="Records (filter)" Style="{StaticResource BigLabel}" /><TextBlock Text="{Binding KpiCount, StringFormat={}{0:N0}}" Style="{StaticResource BigValue}" /></StackPanel>
                </Border>
                <Border>
                    <StackPanel><TextBlock Text="Open" Style="{StaticResource BigLabel}" /><TextBlock Text="{Binding KpiOpen, StringFormat={}{0:N0}}" Style="{StaticResource BigValue}" /></StackPanel>
                </Border>
                <Border ToolTip="Status calculated by the application">
                    <StackPanel><TextBlock Text="At duty risk" Style="{StaticResource BigLabel}" /><TextBlock Text="{Binding KpiDutyRisk, StringFormat={}{0:N0}}" Style="{StaticResource BigValue}" Foreground="{StaticResource Danger}" /></StackPanel>
                </Border>
                <Border ToolTip="Excel 2.0: Balance GENERAL DLLS">
                    <StackPanel><TextBlock Text="Unreconciled general balance (USD)" Style="{StaticResource BigLabel}" /><TextBlock Text="{Binding KpiBalance, StringFormat={}{0:N2}}" Style="{StaticResource BigValue}" /></StackPanel>
                </Border>
            </StackPanel>

            <!-- Filtros (se recuerdan por usuario) -->
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Export to Excel" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0"
                                ToolTip="Exports what you see with the current filters to a protected read-only Excel file (Ctrl+E)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Value Stream" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ValueStreamOptions}" SelectedItem="{Binding SelectedValueStream}" Width="130" Margin="0,0,16,0" />
                        <TextBlock Text="Status" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="210" Margin="0,0,16,0" />
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,16,0"
                                 ToolTip="Folio, part number, HU/batch, invoice, QMM responsible or customs export (Ctrl+F)" />
                        <CheckBox Content="Duty risk only" IsChecked="{Binding OnlyDutyRisk}" Margin="0,0,16,0" />
                        <CheckBox Content="To homogenize" IsChecked="{Binding OnlyDataFindings}" Margin="0,0,16,0"
                                  Visibility="{Binding HasLegacy, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Records imported from the Excel 2.0 that still break a validation rule (open them to see which)" />
                        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Pager: 50 records per page -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="{Binding IsTableShown, Converter={StaticResource BoolToVis}}">
            <DockPanel.Resources>
                <Style x:Key="PagerButton" TargetType="Button">
                    <Setter Property="MinWidth" Value="34" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{StaticResource Primary}" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E8EEF7" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DockPanel.Resources>
            <Button DockPanel.Dock="Right" Content="Hide table" Command="{Binding HideTableCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSeveralPages, Converter={StaticResource BoolToVis}}">
                    <Button Content="«" ToolTip="First page" Command="{Binding FirstPageCommand}" Style="{StaticResource PagerButton}" />
                    <Button Content="‹" ToolTip="Previous page" Command="{Binding PreviousPageCommand}" Style="{StaticResource PagerButton}" />
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button x:Name="Num" Content="{Binding Text}" CommandParameter="{Binding Number}" IsEnabled="{Binding IsPage}"
                                            Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource PagerButton}" />
                                    <!-- current page: filled, not a link -->
                                    <Border x:Name="Cur" Background="{StaticResource Primary}" CornerRadius="6" MinWidth="34" Height="32" Margin="2,0" Visibility="Collapsed">
                                        <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Cur" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="›" ToolTip="Next page" Command="{Binding NextPageCommand}" Style="{StaticResource PagerButton}" />
                    <Button Content="»" ToolTip="Last page" Command="{Binding LastPageCommand}" Style="{StaticResource PagerButton}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource Success}" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Table not shown yet: the records are listed only when the user asks for them -->
        <Border Style="{StaticResource Card}" Visibility="{Binding IsTableShown, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="{Binding ShowButtonText}" Command="{Binding ShowTableCommand}" IsEnabled="{Binding HasRecords}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" FontSize="15" Padding="28,10" HorizontalAlignment="Center" />
                <TextBlock Text="Set the filters first; the indicators above already follow them. The table shows 50 records per page."
                           Style="{StaticResource Hint}" FontSize="12.5" Margin="0,10,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Success}" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid" ItemsSource="{Binding PageRows}" SelectedItem="{Binding SelectedRow}"
                  Visibility="{Binding IsTableShown, Converter={StaticResource BoolToVis}}" Sorting="OnSorting"
                  MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
            <!-- Encabezados del Excel: pueden ser largos, se acomodan en dos renglones -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Folio" Binding="{Binding FolioCode}" Width="105" />
                <DataGridTextColumn Header="VS" Binding="{Binding ValueStream}" Width="48" />
                <DataGridTemplateColumn Header="Status" Width="165" CellTemplate="{StaticResource StatusChip}" SortMemberPath="Status" />
                <DataGridTextColumn Header="Part number" Binding="{Binding Material}" Width="140" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat={}{0:N0}}" Width="60" />
                <DataGridTextColumn Header="SAP value (USD)" Binding="{Binding SapUsdTotal, StringFormat={}{0:N2}}" Width="105" />
                <DataGridTextColumn Header="Balance (USD)" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="105" />
                <DataGridTextColumn Header="Days in JuP1" Binding="{Binding DaysInJuP1}" Width="95" />
                <DataGridTextColumn Header="Days to due" Binding="{Binding DaysToLegalDue}" Width="100" />
                <DataGridTextColumn Header="QMM responsible" Binding="{Binding Qmm}" Width="145" />
                <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice}" Width="105" />
                <DataGridTextColumn Header="Status category" Binding="{Binding Category}" Width="*" MinWidth="215" />
                <DataGridTextColumn x:Name="DqColumn" Header="Data quality" Binding="{Binding DqText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
