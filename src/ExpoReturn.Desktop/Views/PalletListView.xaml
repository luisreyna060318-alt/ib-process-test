<UserControl x:Class="ExpoReturn.Desktop.Views.PalletListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
    </UserControl.InputBindings>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Bandeja de retornos" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Un renglón por pallet retornado de El Paso WHS. El estatus y los montos se calculan solos. Doble clic o Enter para abrir el detalle. Orden: primero los abiertos más próximos a vencer su plazo IMMEX. Atajos: Ctrl+F buscar · Ctrl+E exportar · Ctrl+N nuevo retorno." />

            <!-- Indicadores -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel><TextBlock Text="Registros (filtro)" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding KpiCount}" Style="{StaticResource KpiValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel><TextBlock Text="Abiertos" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding KpiOpen}" Style="{StaticResource KpiValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" ToolTip="Estatus calculado por la aplicación">
                    <StackPanel><TextBlock Text="En riesgo arancelario" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding KpiDutyRisk}" Style="{StaticResource KpiValue}" Foreground="{StaticResource Danger}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" ToolTip="Suma del balance no conciliado de los registros del filtro">
                    <StackPanel><TextBlock Text="Balance GENERAL DLLS" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding KpiBalance, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /></StackPanel>
                </Border>
            </StackPanel>

            <!-- Filtros (se recuerdan por usuario) -->
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Exportar a Excel" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0"
                                ToolTip="Exporta lo que ve con los filtros actuales a un Excel protegido de sólo lectura (Ctrl+E)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Value Stream" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ValueStreamOptions}" SelectedItem="{Binding SelectedValueStream}" Width="130" Margin="0,0,16,0" />
                        <TextBlock Text="Estatus" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Width="210" Margin="0,0,16,0" />
                        <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,16,0"
                                 ToolTip="Folio, número de parte, HU/lote, factura, responsable QMM o exportación aduanal (Ctrl+F)" />
                        <CheckBox Content="Sólo riesgo arancelario" IsChecked="{Binding OnlyDutyRisk}" Margin="0,0,16,0" />
                        <Button Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Abrir detalle" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Enter" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource Success}" Margin="8,0,0,0" />
            <TextBlock Text="Los filtros se recuerdan por usuario." VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="16,0,0,0" />
        </StackPanel>

        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKeyDown">
            <!-- Encabezados del Excel: pueden ser largos, se acomodan en dos renglones -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding FolioCode}" Width="95" />
                <DataGridTextColumn Header="VS" Binding="{Binding ValueStream}" Width="48" />
                <DataGridTemplateColumn Header="Estatus" Width="165" CellTemplate="{StaticResource StatusChip}" SortMemberPath="Status" />
                <DataGridTextColumn Header="Returned Pallet 13 Digits Part number" Binding="{Binding Material}" Width="150" />
                <DataGridTextColumn Header="Quantity imported" Binding="{Binding Qty, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="SAP USD TOTAL" Binding="{Binding SapUsdTotal, StringFormat={}{0:N2}}" Width="105" />
                <DataGridTextColumn Header="Balance GENERAL DLLS" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="105" />
                <DataGridTextColumn Header="Días en JuP1" Binding="{Binding DaysInJuP1}" Width="95" />
                <DataGridTextColumn Header="Días p/vencer" Binding="{Binding DaysToLegalDue}" Width="100" />
                <DataGridTextColumn Header="QMM Responsible" Binding="{Binding Qmm}" Width="145" />
                <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice}" Width="105" />
                <DataGridTextColumn Header="COMMENTS" Binding="{Binding Category}" Width="*" MinWidth="215" />
                <DataGridTextColumn x:Name="DqColumn" Header="Calidad de datos" Binding="{Binding DqText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
