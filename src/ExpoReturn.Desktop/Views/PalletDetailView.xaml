<UserControl x:Class="ExpoReturn.Desktop.Views.PalletDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
            <DataTemplate x:Key="IssueTemplate">
                <Button Command="{Binding DataContext.GoToIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                        Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,6">
                    <Border BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}" BorderThickness="3,0,0,0" Background="#F9FAFB" Padding="8,5">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SeverityText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Button>
            </DataTemplate>
        <!-- ===== Resaltado de permisos: campo editable por el usuario actual = verde ligero; sin permiso = gris ===== -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource EditableFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditableBorder}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ReadOnlyFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                    <Setter Property="Foreground" Value="#4B5563" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{StaticResource ReadOnlyFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MultiLine" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Background" Value="{StaticResource EditableFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditableBorder}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ReadOnlyFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                    <Setter Property="Opacity" Value="0.8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{StaticResource EditableFill}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ReadOnlyFill}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox: the standard Windows template ignores Background, so a simple custom template is used -->
        <ControlTemplate x:Key="FieldComboToggle" TargetType="ToggleButton">
            <Border Background="Transparent">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4,4 L8,0"
                      Stroke="#4B5563" StrokeThickness="1.6" />
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="FieldComboTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                <ToggleButton Template="{StaticResource FieldComboToggle}" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden" Margin="3,0,24,0" Padding="4,0"
                         Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="{TemplateBinding FontSize}"
                         Foreground="{TemplateBinding Foreground}" IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" />
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="Slide">
                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="White" BorderBrush="#9CA3AF" BorderThickness="1">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EditableFocus}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Template" Value="{StaticResource FieldComboTemplate}" />
            <Setter Property="Background" Value="{StaticResource EditableFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditableBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4,26,4" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ReadOnlyFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                    <Setter Property="Foreground" Value="#4B5563" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox: toda la casilla (cuadro + texto) se resalta -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Background" Value="{StaticResource EditableFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource EditableBorder}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="7,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" Background="White" BorderBrush="#6B7280" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                    <Path x:Name="Check" Data="M2.5,7 L5.5,10 L11.5,3.5" Stroke="{StaticResource EditableFocus}" StrokeThickness="2" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EditableFocus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ReadOnlyFill}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                                <Setter TargetName="Check" Property="Stroke" Value="#6B7280" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Grid3" TargetType="UniformGrid">
            <Setter Property="Columns" Value="3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ReadOnlyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="QtyRow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoToTabCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoToTabCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoToTabCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding GoToTabCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding GoToTabCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding GoToTabCommand}" CommandParameter="6" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- ===== Encabezado ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="← Inbox" ToolTip="Esc" Command="{Binding BackCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,14,0" />
                        <Border Background="{Binding PreviewStatus, Converter={StaticResource StatusBrush}}" CornerRadius="11" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewStatusName}" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="11" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Excel history (read-only)" Foreground="#92400E" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="#FEE2E2" CornerRadius="11" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Unsaved changes" Foreground="#991B1B" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Background="{StaticResource EditableFill}" BorderBrush="{StaticResource EditableBorder}" BorderThickness="1" Width="26" Height="14" CornerRadius="2" VerticalAlignment="Center" />
                        <TextBlock Text="You can edit it" Style="{StaticResource Hint}" FontSize="12" Margin="6,0,14,0" VerticalAlignment="Center" />
                        <Border Background="{StaticResource ReadOnlyFill}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Width="26" Height="14" CornerRadius="2" VerticalAlignment="Center" />
                        <TextBlock Text="Read-only (another area, another VS or closed record)" Style="{StaticResource Hint}" FontSize="12" Margin="6,0,14,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding EditableSummary}" Style="{StaticResource Hint}" FontSize="12" />
                    <TextBlock Text="{Binding DutyRiskReason}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" Margin="0,4,0,0"
                               Visibility="{Binding DutyRiskReason, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource KpiCard}" MinWidth="130">
                        <StackPanel><TextBlock Text="Balance (USD)" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding Preview.BalanceGeneralUsd, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="120">
                        <StackPanel><TextBlock Text="Days in JuP1" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding DaysInJuP1, TargetNullValue=—}" Style="{StaticResource KpiValue}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" MinWidth="140">
                        <StackPanel><TextBlock Text="IMMEX due date" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding LegalDueDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue=—}" Style="{StaticResource KpiValue}" /></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Barra de acciones ===== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="110" ToolTip="Ctrl+S" />
                    <Button Content="Discard changes" Command="{Binding DiscardCommand}" Style="{StaticResource SecondaryButton}" />
                    <TextBlock Text="Reason (Owner only, on closed records):" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SaveReason, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                </StackPanel>
                <Border Margin="12,0,0,0" CornerRadius="4" Padding="10,5" Visibility="{Binding Message, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== Right panel: validations and reconciliation ===== -->
        <Border DockPanel.Dock="Right" Width="350" Style="{StaticResource Card}" Margin="10,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Quantity reconciliation" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Temporarily imported" Style="{StaticResource QtyRow}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Edit.QtyImported, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="✔ Exported with document" Style="{StaticResource QtyRow}" Foreground="{StaticResource Success}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding QtyExported, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="2" Text="✔ Scrap confirmed by HSE" Style="{StaticResource QtyRow}" Foreground="{StaticResource Success}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QtyScrapConfirmed, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="3" Text="• On MFO floor / quarantine" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preview.QtyOpenFloor, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="4" Text="• In LOW without pedimento" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Preview.QtyPendingExport, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="5" Text="• Scrap not confirmed (HSE)" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Preview.QtyPendingHse, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" />
                        <TextBlock Grid.Row="6" Text="✖ Missing without evidence" Style="{StaticResource QtyRow}" Foreground="{StaticResource Danger}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Preview.QtyMissing, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" Foreground="{StaticResource Danger}" />
                        <TextBlock Grid.Row="7" Text="Total open" Style="{StaticResource QtyRow}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Preview.QtyOpenTotal, StringFormat={}{0:N0}}" Style="{StaticResource QtyRow}" FontWeight="SemiBold" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Validations" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ErrorCount, StringFormat='  {0} error(s)'}" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding WarningCount, StringFormat='  · {0} warning(s)'}" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </StackPanel>
                    <TextBlock Text="Click a validation to go to its tab. Errors block saving; warnings do not." Style="{StaticResource Hint}" Margin="0,0,0,6" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" />
                        <Expander Header="{Binding PendingHeader}" IsExpanded="{Binding PendingExpanded}" Margin="0,4,0,0"
                                  Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" Foreground="#B45309" FontWeight="SemiBold"
                                  ToolTip="Required request data. They do not block saving the draft.">
                            <ItemsControl ItemsSource="{Binding PendingIssues}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,6,0,0" FontWeight="Normal" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Tabs by block ===== -->
        <TabControl SelectedIndex="{Binding SelectedTab}" Background="White" BorderBrush="{StaticResource BorderBrushLight}">

            <!-- 1 · Request -->
            <TabItem Header="1 · Request (QMM)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Stage 1 · Request — QMM and requesting area" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,12" Text="* Required to move to Requested (enter the original HU or the original batch). Hover over a field to see its Excel 2.0 column, the rule and an example." />
                        <UniformGrid Style="{StaticResource Grid3}">
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ValueStreamId]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Value Stream (VS)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ValueStreamOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Edit.ValueStreamId}" IsEnabled="{Binding Perm[ValueStreamId]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[FolioNumber]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Folio" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FolioDisplay, Mode=OneWay}" Style="{StaticResource ReadOnlyBox}" />
                                <TextBlock Text="Sequential per Value Stream" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[QmmResponsible]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="QMM Responsible (Champion / Proxy) *" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding QmmOptions}" Text="{Binding Edit.QmmResponsible, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding Perm[QmmResponsible]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[RequestingDepartment]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Requesting Department *" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding DepartmentOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Edit.RequestingDepartment}" IsEnabled="{Binding Perm[RequestingDepartment]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[RequestorName]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Requestor (Last name, First name) *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.RequestorName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[RequestorName]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ReasonId]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Reason *" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ReasonOptions}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding Edit.ReasonId}" IsEnabled="{Binding Perm[ReasonId]}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Code}" /></Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ReturnReasonDetail]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                            <TextBlock Text="Reason Detail" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Edit.ReturnReasonDetail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}" IsEnabled="{Binding Perm[ReturnReasonDetail]}" />
                        </StackPanel>

                        <TextBlock Text="Original pallet in El Paso" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Style="{StaticResource Grid3}">
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ReturnedMaterial]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Returned Part Number (13 digits) *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ReturnedMaterial, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[ReturnedMaterial]}" CharacterCasing="Upper" />
                                <TextBlock Text="{Binding NormalizedMaterialHint}" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[UnitCostUsd]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="MM60 Unit Cost (USD)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.UnitCostUsd, Mode=OneWay, StringFormat={}{0:N4}, TargetNullValue='No cost (COSTEAR)'}" Style="{StaticResource ReadOnlyBox}" />
                                <TextBlock Text="{Binding Edit.UnitCostSource, StringFormat='Source: {0}'}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[SapUsdTotal]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="SAP Total (USD)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.SapUsdTotal, Mode=OneWay, StringFormat={}{0:N2}}" Style="{StaticResource ReadOnlyBox}" />
                                <TextBlock Text="Calculated" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[QtyImported]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Quantity Imported *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.QtyImported, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[QtyImported]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[OriginalHU]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Original HU (10 digits) *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.OriginalHU, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[OriginalHU]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[OriginalBatch]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Original Batch *" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.OriginalBatch, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[OriginalBatch]}" CharacterCasing="Upper" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[DateReturnedToWhs]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="PO Date / Returned to WHS" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.DateReturnedToWhs}" IsEnabled="{Binding Perm[DateReturnedToWhs]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ReturnPONumber]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="PO Number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ReturnPONumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[ReturnPONumber]}" />
                                <TextBlock Text="8 digits" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2 · Customs / inbound -->
            <TabItem Header="2 · Customs / inbound">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Stage 2 · Customs and inbound logistics (El Paso → JuP1) — GS/OSD43 and LOP" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Style="{StaticResource Grid3}">
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ImportDate]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Import Date" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.ImportDate}" IsEnabled="{Binding Perm[ImportDate]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ImportInvoice]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Import Invoice" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ImportInvoice, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[ImportInvoice]}" CharacterCasing="Upper" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ImportDateElpJup1]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="ELP → JuP1 Crossing Date" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.ImportDateElpJup1}" IsEnabled="{Binding Perm[ImportDateElpJup1]}" />
                                <TextBlock Text="Opens the IMMEX cycle: aging and legal term start" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[DeliveryNumber]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Delivery Number (LOP)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.DeliveryNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[DeliveryNumber]}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3 · MFO execution -->
            <TabItem Header="3 · MFO execution">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Stage 3 · Plant execution (rework) — MFO" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Style="{StaticResource Grid3}">
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[NewMaterial]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="New Part Number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.NewMaterial, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[NewMaterial]}" CharacterCasing="Upper" />
                                <TextBlock Text="Required and different if the reason is reflash" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[PhysicalDeliveredQty]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Physical Delivered to LOW" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.PhysicalDeliveredQty, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsEnabled="{Binding Perm[PhysicalDeliveredQty]}" />
                                <TextBlock Text="Old material + reinsertion. Entering it CLOSES the MFO rework" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[NewHU]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="New HU" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.NewHU, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[NewHU]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ReworkBatch]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Rework Batch" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ReworkBatch, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[ReworkBatch]}" CharacterCasing="Upper" />
                                <TextBlock Text="Batch of the reworked pallet" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ReinsertionQty]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Reinsertion Qty" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ReinsertionQty, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsEnabled="{Binding Perm[ReinsertionQty]}" />
                                <TextBlock Text="NEW material added (not a temporary import)" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[DateSentBack]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Sent Back Date" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.DateSentBack}" IsEnabled="{Binding Perm[DateSentBack]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[OldMaterialDeliveredQty]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Old Material Delivered to LOW" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.OldMaterialDeliveredQty, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsEnabled="{Binding Perm[OldMaterialDeliveredQty]}" />
                                <TextBlock Text="IMPORTED pieces returned to LOW" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ScrapQty]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Scrap Qty (HSE)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ScrapQty, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsEnabled="{Binding Perm[ScrapQty]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ScrapDate]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Scrap Date" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.ScrapDate}" IsEnabled="{Binding Perm[ScrapDate]}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4 · Exit / HSE -->
            <TabItem Header="4 · Exit / HSE">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Stage 4 · Material exit — LOW, GS/OSD43, MFO and HSE" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Style="{StaticResource Grid3}">
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[LowExportNumber]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="LOW Export Number" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.LowExportNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsEnabled="{Binding Perm[LowExportNumber]}" />
                                <TextBlock Text="Expo number (e.g. 4)" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[LowExportDate]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="LOW Export Date" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.LowExportDate}" IsEnabled="{Binding Perm[LowExportDate]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[CustomsExportReference]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Customs Export (PRyy-##### · F4 · V1)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.CustomsExportReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[CustomsExportReference]}" CharacterCasing="Upper" />
                                <TextBlock Text="{Binding ClosureText}" Style="{StaticResource Hint}" Foreground="{StaticResource Accent}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[ScrapGrNumber]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="GR Number (MFO)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.ScrapGrNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Perm[ScrapGrNumber]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[HseScrapKg]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="HSE Scrap (kg)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Edit.HseScrapKg, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsEnabled="{Binding Perm[HseScrapKg]}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[HseConfirmationDate]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="HSE Confirmation Date" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Edit.HseConfirmationDate}" IsEnabled="{Binding Perm[HseConfirmationDate]}" />
                                <TextBlock Text="With GR + kg + date, scrap leaves the balance" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5 · Balance and status -->
            <TabItem Header="5 · Balance and status">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Stage 5 · Calculation engine (automatic, no manual entry)" Style="{StaticResource SectionTitle}" />
                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="General Balance (USD)" Style="{StaticResource KpiLabel}" ToolTip="{Binding Help[BalanceGeneralUsd]}" /><TextBlock Text="{Binding Preview.BalanceGeneralUsd, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /><TextBlock Text="Sum of the next three" Style="{StaticResource Hint}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="MFO Inventory (USD)" Style="{StaticResource KpiLabel}" ToolTip="{Binding Help[MfoInventoryUsd]}" /><TextBlock Text="{Binding Preview.MfoInventoryUsd, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /><TextBlock Text="Material still on the MFO floor" Style="{StaticResource Hint}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="HSE Scrap (USD)" Style="{StaticResource KpiLabel}" ToolTip="{Binding Help[HseScrapUsd]}" /><TextBlock Text="{Binding Preview.HseScrapUsd, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /><TextBlock Text="Scrap without HSE confirmation" Style="{StaticResource Hint}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="MFO-LOW Failure (USD)" Style="{StaticResource KpiLabel}" ToolTip="{Binding Help[MfoLowFailureUsd]}" /><TextBlock Text="{Binding Preview.MfoLowFailureUsd, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /><TextBlock Text="In LOW without pedimento + missing" Style="{StaticResource Hint}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Duties to Pay (USD)" Style="{StaticResource KpiLabel}" ToolTip="{Binding Help[DutiesToPayUsd]}" /><TextBlock Text="{Binding Preview.DutiesToPayUsd, StringFormat={}{0:N2}}" Style="{StaticResource KpiValue}" /><TextBlock Text="MFO-LOW failure × 0.19" Style="{StaticResource Hint}" /></StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Classification (QMM)" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Style="{StaticResource Grid3}">
                            <StackPanel Style="{StaticResource Field}" ToolTip="{Binding Help[StatusCategoryCode]}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="Status Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding CommentsOptions}" SelectedItem="{Binding Edit.StatusCategoryCode}" IsEnabled="{Binding Perm[StatusCategoryCode]}" />
                                <TextBlock Text="Options of the VS sheet COMMENTS list. EXPORT / SCRAP / INVENTORY are set automatically" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Data quality findings (Excel import)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Edit.DataQualityText, Mode=OneWay}" Style="{StaticResource ReadOnlyBox}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Edit.LegacySource, StringFormat='Source: {0}'}" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 6 · Audit -->
            <TabItem Header="6 · Audit">
                <DockPanel Margin="16,12">
                    <TextBlock DockPanel.Dock="Top" Text="Who changed what and when (old value → new). In production: IB_PROCESS_AUDIT_LOG with the Windows user." Style="{StaticResource PageSubtitle}" />
                    <DataGrid ItemsSource="{Binding AuditEntries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / time" Binding="{Binding ChangedAtLocal, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130" />
                            <DataGridTextColumn Header="User" Binding="{Binding NtUser}" Width="130" />
                            <DataGridTextColumn Header="Field" Binding="{Binding Field, Converter={StaticResource FieldNameConv}}" Width="210" />
                            <DataGridTextColumn Header="Old value" Binding="{Binding OldValue}" Width="*" />
                            <DataGridTextColumn Header="New value" Binding="{Binding NewValue}" Width="*" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
