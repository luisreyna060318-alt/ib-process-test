<UserControl x:Class="ExpoReturn.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Users &amp; Access" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Each user is identified by their Windows account. The table below says, per department and Value Stream, whether the user is Champion, Proxy or Viewer; the Owner has full access regardless of department and VS. Only the Owner can change it." />

            <!-- Pending profile requests (Owner) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasRequests, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Pending profile requests" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Users who changed their department or Value Streams in My profile. Approving applies the change; Value Streams added start as Viewer, and a department change resets Champion/Proxy to Viewer." />
                    <DataGrid ItemsSource="{Binding Requests}" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Requested" Binding="{Binding RequestedAtLocal, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130" />
                            <DataGridTextColumn Header="User" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Windows user" Binding="{Binding NtUser}" Width="*" />
                            <DataGridTextColumn Header="Current" Binding="{Binding CurrentDepartment}" Width="90" />
                            <DataGridTextColumn Header="Current VS" Binding="{Binding CurrentValueStreams}" Width="140" />
                            <DataGridTextColumn Header="Requested" Binding="{Binding RequestedDepartment}" Width="90" />
                            <DataGridTextColumn Header="Requested VS" Binding="{Binding RequestedValueStreams}" Width="140" />
                            <DataGridTemplateColumn Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button Content="Approve" Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="Reject" Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Access table (Owner edits) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="User access (User · Department · Value Stream · Function)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="One row = one user in one department and VS. To give the same user another VS or function, select the row and use 'Add row' (copies user and department). Owner rows ignore department and VS (leave VS = 0). Changes apply on save and go to the audit log." />
                    <TextBlock Text="Only the Owner can change user access (read-only for you)."
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <DataGrid ItemsSource="{Binding EditRows}" SelectedItem="{Binding SelectedEdit}" IsReadOnly="False" CanUserAddRows="False"
                              IsEnabled="{Binding CanEdit}" MaxHeight="420" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Windows user" Binding="{Binding NtUser, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" IsReadOnly="False" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Department" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DepartmentOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DepartmentCode, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Value Stream" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ValueStreamOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding ValueStreamId, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="VS{0}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Function" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FunctionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Function, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
                        <Button Content="Add row" Command="{Binding AddAccessCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Remove row" Command="{Binding RemoveAccessCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Save changes" Command="{Binding SaveChangesCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Discard" Command="{Binding DiscardChangesCommand}" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OwnersConfigText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Read-only summary -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Champion / Proxy matrix" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Rows}" RowHeight="NaN" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VS" Binding="{Binding ValueStream}" Width="50" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="QMM" Binding="{Binding Qmm}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="MFQ" Binding="{Binding Mfq}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="GS / OSD43" Binding="{Binding Gs}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="LOP" Binding="{Binding Lop}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="MFO" Binding="{Binding Mfo}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="LOW" Binding="{Binding Low}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="HSE" Binding="{Binding Hse}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Fields each area can edit (Champion or Proxy, in their Value Streams)" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding EditableByArea}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
