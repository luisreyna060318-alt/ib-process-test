<UserControl x:Class="ExpoReturn.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Users &amp; Access" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Each user is identified by their Windows account. The table below says, per department and Value Stream, whether the user is Champion, Proxy, Member or Viewer; new users and profile changes are approved in Requests; the Owner has full access regardless of department and VS. Only the Owner can change it." />

            <!-- Access matrix (Owner edits): one row per user and department, one column per Value Stream -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="User access (User · Department · function in each Value Stream)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="One row = one user in one department; each Value Stream column says the function there (— = no access). 'All VS' sets every column at once. Owner rows have full access (no department). 'Add row' adds a user, or another department of the selected user. Changes apply on save, go to the audit log, and ended access is kept as history." />
                    <TextBlock Text="Only the Owner can change user access (read-only for you)."
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,16,0"
                                 ToolTip="Windows user or name" />
                        <TextBlock Text="Department" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DepartmentFilterOptions}" SelectedItem="{Binding DepartmentFilter}" DisplayMemberPath="Label" Width="170" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ShownUsers, StringFormat='{}{0:N0} row(s)'}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    </WrapPanel>
                    <DataGrid x:Name="AccessGrid" ItemsSource="{Binding EditView}" SelectedItem="{Binding SelectedEdit}" IsReadOnly="False" CanUserAddRows="False"
                              IsEnabled="{Binding CanEdit}" MaxHeight="460" RowHeight="32" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Windows user" Width="170" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding NtUser}" VerticalAlignment="Center" Margin="4,0" />
                                            <!-- only a new row lets the user be typed -->
                                            <TextBox Text="{Binding NtUser, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                     Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Name" Width="*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="4,0" />
                                            <!-- only a new row lets the name be typed (used when the user is not registered yet) -->
                                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" MaxLength="150"
                                                     Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Owner" Width="64" MinWidth="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsOwner, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                                  ToolTip="Owner: full access, every department and VS" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Department" Width="130" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DepartmentOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DepartmentCode, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding HasDepartment}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="All VS" Width="115" MinWidth="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.CellOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding AllVs, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasDepartment}"
                                                  ToolTip="Sets the same function in every Value Stream (empty = they differ)" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- one column per Value Stream is added by UsersView.xaml.cs (from the VS catalog) -->
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
                        <Button Content="Add row" Command="{Binding AddAccessCommand}" Style="{StaticResource SecondaryButton}"
                                ToolTip="New user, or another department of the selected user" />
                        <Button Content="End access" ToolTip="Ends every access of the selected row when you save. Nothing is deleted: it stays in the history." Command="{Binding RemoveAccessCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Save changes" Command="{Binding SaveChangesCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Discard" Command="{Binding DiscardChangesCommand}" Style="{StaticResource LinkButton}" />
                        <Button Content="Departments…" Command="{Binding OpenDepartmentsCommand}" Style="{StaticResource SecondaryButton}" Margin="24,0,0,0"
                                ToolTip="Owner: add a department, or stop / start offering one. Departments are never deleted" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OwnersConfigText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Read-only summary -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Champion / Proxy matrix" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Rows}" RowHeight="NaN" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VS" Binding="{Binding ValueStream}" Width="50" MinWidth="50" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="QMM" Binding="{Binding Qmm}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="MFQ / PUQ (read only)" Binding="{Binding Mfq}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="OSD" Binding="{Binding Gs}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="LOP" Binding="{Binding Lop}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="MFO" Binding="{Binding Mfo}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="LOW" Binding="{Binding Low}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="HSE" Binding="{Binding Hse}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Fields each area can edit (in their Value Streams). The request is always made by QMM: QMM creates the IB processes and fills the request (Champion / Proxy: every process of the VS and delete; Member: the processes they created or are QMM Responsible of). OSD, LOP, MFO, LOW and HSE fill only their fields, in every process of their VS. Every area of the form sets the Status Category and writes comments. MFQ and PUQ only read." Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding EditableByArea}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
