<UserControl x:Class="ExpoReturn.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Alerts" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="What nobody sees in the Excel today: IMMEX terms about to expire, missing pieces, material in LOW without pedimento and unconfirmed scrap. Grouped by responsible area, 50 per page. When you handle an alert, record the action taken; it goes to the audit log." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel><TextBlock Text="Critical pending" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding Critical}" Style="{StaticResource KpiValue}" Foreground="{StaticResource Danger}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel><TextBlock Text="Warnings pending" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding Warnings}" Style="{StaticResource KpiValue}" Foreground="#B45309" /></StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel><TextBlock Text="Handled" Style="{StaticResource KpiLabel}" /><TextBlock Text="{Binding Acknowledged}" Style="{StaticResource KpiValue}" Foreground="{StaticResource Success}" /></StackPanel>
                </Border>
                <TextBlock Text="Responsible" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AreaOptions}" SelectedItem="{Binding SelectedArea}" Width="130" VerticalAlignment="Center"
                          ToolTip="Only the alerts where this area is responsible" />
                <CheckBox Content="Show handled" IsChecked="{Binding ShowAcknowledged}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </StackPanel>
        <!-- Pager: 50 alerts per page, calculated by the database -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSeveralPages, Converter={StaticResource BoolToVis}}">
                    <Button Content="«" ToolTip="First page" Command="{Binding FirstPageCommand}" Style="{StaticResource PagerButton}" />
                    <Button Content="‹" ToolTip="Previous page" Command="{Binding PreviousPageCommand}" Style="{StaticResource PagerButton}" />
                    <ItemsControl ItemsSource="{Binding PageButtons}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button x:Name="Num" Content="{Binding Text}" CommandParameter="{Binding Number}" IsEnabled="{Binding IsPage}"
                                            Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource PagerButton}" />
                                    <Border x:Name="Cur" Background="{StaticResource Primary}" CornerRadius="6" MinWidth="34" Height="32" Margin="2,0" Visibility="Collapsed">
                                        <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Cur" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Num" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="›" ToolTip="Next page" Command="{Binding NextPageCommand}" Style="{StaticResource PagerButton}" />
                    <Button Content="»" ToolTip="Last page" Command="{Binding LastPageCommand}" Style="{StaticResource PagerButton}" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{StaticResource Danger}" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
        <DataGrid ItemsSource="{Binding Alerts}" RowHeight="34">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#E8EDF5" Padding="8,5" Margin="0,6,0,0">
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Primary}">
                                    <Run Text="Responsible: " /><Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Severity" Width="95" MinWidth="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="210" MinWidth="210" />
                <DataGridTextColumn Header="Folio" Binding="{Binding FolioCode}" Width="95" MinWidth="95" />
                <DataGridTextColumn Header="VS" Binding="{Binding ValueStream}" Width="50" MinWidth="50" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="*" />
                <DataGridTextColumn Header="Handling" Binding="{Binding AckText}" Width="*" />
                <DataGridTemplateColumn Header="" Width="170" MinWidth="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" Style="{StaticResource LinkButton}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Content="Mark as handled" Style="{StaticResource LinkButton}"
                                        Visibility="{Binding IsAcknowledged, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                        Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Text="No alerts match the filters" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        </Grid>
    </DockPanel>
</UserControl>
