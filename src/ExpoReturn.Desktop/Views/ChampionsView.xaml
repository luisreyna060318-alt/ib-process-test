<UserControl x:Class="ExpoReturn.Desktop.Views.ChampionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Matriz Champions VS" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Quién es Champion / Proxy de cada área por Value Stream (Process Owner: Ezequiel Loya Morales). La matriz define en qué VS puede editar cada usuario, en todas las áreas; una misma persona puede estar asignada a varios VS. Con datos demo los nombres son ficticios; al importar el Excel se leen de la hoja 'Champions VS'." />
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Matriz vigente" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Rows}" RowHeight="NaN" MinRowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VS" Binding="{Binding ValueStream}" Width="50" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="QMM" Binding="{Binding Qmm}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="MFQ" Binding="{Binding Mfq}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="GS / OSD43" Binding="{Binding Gs}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="LOP" Binding="{Binding Lop}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="MFO" Binding="{Binding Mfo}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="LOW" Binding="{Binding Low}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                            <DataGridTextColumn Header="HSE" Binding="{Binding Hse}" Width="*" ElementStyle="{StaticResource WrapCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- UX-B10: edición por Admin QMM/PE (sin vigencias; la baja queda en la bitácora) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Administrar la matriz (sólo Admin QMM / Process Excellence)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Un renglón = una persona en un VS. Para asignar a la misma persona a otro VS, selecciónela y use 'Agregar asignación' (copia nombre y área). Para cambiar a un Champion/Proxy, dé de baja su renglón y agregue al nuevo. Los cambios aplican al guardar, quedan en la bitácora y actualizan de inmediato los usuarios simulados y sus permisos." />
                    <TextBlock Text="Su rol no administra la matriz (sólo lectura). Cambie el usuario simulado a Admin para probar la edición."
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <DataGrid ItemsSource="{Binding EditRows}" SelectedItem="{Binding SelectedEdit}" IsReadOnly="False" CanUserAddRows="False"
                              IsEnabled="{Binding CanEdit}" MaxHeight="360" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="False" />
                            <DataGridTemplateColumn Header="Área" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="VS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ValueStreamOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding ValueStreamId, UpdateSourceTrigger=PropertyChanged}" ItemStringFormat="VS{0}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Asignación" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AssignmentOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Assignment, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
                        <Button Content="Agregar asignación" Command="{Binding AddPersonCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Dar de baja" Command="{Binding EndPersonCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Guardar cambios" Command="{Binding SaveChangesCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Descartar" Command="{Binding DiscardChangesCommand}" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Campos que edita cada rol (bloques del Excel)" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding EditableByRole}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Observación del Excel real: la matriz no tiene columnas para LOP ni HSE, y sólo VS1 tiene LOW y OSD43 asignados. Con el Excel importado, las áreas sin asignación no pueden editar hasta que el Admin las agregue aquí. [Por definir con el Process Owner]" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
